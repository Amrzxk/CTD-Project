# Frontend configuration (Vite). Copy to dashboard/.env and adjust.
#
# Base URL of the H-IDS API. For local docker-compose this is the
# host-published API port; for a TLS deployment behind Caddy use the
# same-origin "/api" path instead.
VITE_API_URL=http://localhost:8000

# When "true", the dashboard runs entirely on mock data with no backend.
# Leave "false" for real operation.
VITE_USE_MOCK=false
