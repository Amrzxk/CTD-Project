# -------------------------------------------------------
#  Environment variables for the Hybrid IDS
#  Copy to .env and adjust for your environment.
# -------------------------------------------------------

# --- Runtime environment ---
# 'local' = Docker Redis, loopback replay, tcpreplay
# 'aws'   = EC2 with VPC Traffic Mirroring
APP_ENV=local

# --- Database (Postgres) ---
# Async URL — must include `+asyncpg` for SQLAlchemy. The docker-compose
# postgres service uses these defaults; for AWS RDS, swap host/credentials.
DATABASE_URL=postgresql+asyncpg://hids:hids@127.0.0.1:5432/hids
# Used by the postgres service in docker-compose.yml (POSTGRES_PASSWORD).
# Compose refuses to start if this is empty, by design.
POSTGRES_PASSWORD=hids

# --- Auth ---
# HS256 signing key for session JWTs. MUST be ~32+ random bytes in prod.
# Rotate to force all users to re-authenticate.
JWT_SECRET=change-me-to-32-random-bytes-or-more
# Cookie hardening. Set to 1 in any TLS-fronted deployment so the session
# cookie is only sent over HTTPS. Leave 0 for plain-http local dev.
COOKIE_SECURE=0
# Comma-separated list of origins allowed to call the API with credentials.
# With credentialed CORS, wildcard origins are rejected by the browser.
CORS_ORIGINS=http://localhost:5173
# Seeded on first start if the users table is empty. Both must be set or
# the API will log a warning and start with no users (every request 401s).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Retention ---
# Predictions older than this are deleted by the background retention task.
# Unset (or 0) disables time-based retention. Postgres can hold millions of
# rows happily; this is the operational lever.
RETENTION_DAYS=90
# Optional absolute row cap as a belt-and-braces safeguard. Default empty
# means unlimited. Set to e.g. 200000 to delete oldest rows above the cap.
MAX_PREDICTIONS_HARD_CAP=

# --- API process ---
# Number of gunicorn workers when running via the Dockerfile.api CMD.
API_WORKERS=4

# --- Snort tailer ---
# When 1, FastAPI lifespan starts the Snort tailer as a child process.
# Off by default so people who use start_all.ps1 (which launches the
# tailer separately) don't end up with two tailers fighting over the log.
SNORT_TAILER_AUTOSTART=0

# --- Live sessions ---
# Hard ceiling on the size of an uploaded PCAP for /live/session/{id}/pcap.
# Defends against a 20 GB capture being dropped into the API container.
# Default 2 GiB.
LIVE_PCAP_REPLAY_MAX_BYTES=2147483648

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave empty (or omit) for unauthenticated local Docker Redis.
# Set for AWS ElastiCache or any password-protected instance.
REDIS_PASSWORD=

# --- Network Capture ---
# Local  : lo, eth0, replay0, or any loopback / replay interface
# AWS    : The ENI created by VPC Traffic Mirroring (e.g. ens5)
CAPTURE_INTERFACE=lo

# --- Flow Meter tuning ---
# TTL (seconds) for per-flow Redis hashes.
FLOW_TTL_SECONDS=60
# NFStream idle / active flow timeouts (seconds). "Fast active, safe idle":
# active_timeout=10 caps export at ~10s so live attacks export fast and ML
# joins the Snort hit into a `confirmed` verdict within seconds. idle stays
# 30 (anti-fragmentation: a short idle chops laggy floods into Probe-looking
# fragments). Keep ACTIVE_TIMEOUT < SNORT_JOIN_WAIT_S <= SNORT_HASH_TTL.
NFSTREAM_IDLE_TIMEOUT=30
NFSTREAM_ACTIVE_TIMEOUT=10

# --- Live PCAP replay ---
# Max-speed ("Max" / speed=0) emission ceiling, events/sec. Bounds the live SSE
# rate so a large PCAP replayed at Max can't firehose the dashboard. 0 disables
# the cap. ~1500 replays ~100k flows in ~60s while staying smooth in-browser.
PCAP_REPLAY_MAX_EPS=1500

# --- Snort 3 ---
# Two supported topologies:
#
# 1. Native: Snort runs on the same host as the Python stack. Leave
#    SNORT_WSL_DISTRO unset; SNORT_BIN and SNORT_CONFIG must be paths
#    that exist on this host.
# 2. WSL bridge (Windows host, Snort in WSL2): SNORT_WSL_DISTRO is the
#    distro name; snort_offline.py will invoke `wsl.exe -d <distro> -- snort`
#    and translate Windows path args to /mnt/<drive>/... form. The alert log
#    lives on the host filesystem so both sides can read/write the same file.
#
# Bundled smoke-test config:
#   Testing/snort/snort.lua (loads Testing/snort/local.rules)
#   Logs to f:/GradProject/.tmp/snort/logs/alert_json.txt
#
# Optional: SNORT_WSL_DISTRO=Ubuntu-24.04
SNORT_WSL_DISTRO=
SNORT_BIN=snort
SNORT_CONFIG=/mnt/f/GradProject/Testing/snort/snort.lua
# Required when Snort is built from source and the DAQ plugin dir is not on
# the system default search path (typical for /usr/local installs).
SNORT_DAQ_DIR=/usr/local/lib/daq
# Path the tailer worker reads (Windows view) and Snort writes (WSL view of
# the same file via /mnt/f/...). Must match across both topologies.
SNORT_ALERT_LOG=f:/GradProject/.tmp/snort/logs/alert_json.txt
# Seconds between file polls when tailing the alert log.
SNORT_POLL_INTERVAL=0.25
# Redis TTL (seconds) for per-flow `snort:<flow_key>` hashes the tailer writes.
# Keep >= SNORT_JOIN_WAIT_S so the hash outlives the NFStream flow-export delay
# (see Hybrid correlation tuning below).
SNORT_HASH_TTL=60
# Max seconds the offline replay (/analyze/upload) waits for Snort to finish.
SNORT_OFFLINE_TIMEOUT=300

# --- Hybrid correlation tuning (live ML <-> Snort join) ---
# Snort fires per-packet (instant); NFStream exports a flow's features only on
# idle/active timeout. The joiner holds a Snort alert SNORT_JOIN_WAIT_S seconds
# waiting for its flow so ML can run and the pair becomes `confirmed` (vs.
# reaping early as signature_only). CORRELATION_WINDOW_S is the reap cadence:
# keep it SHORT — flow-only (ml_only) events are processed immediately on
# arrival (while their Redis hash is fresh), so the reap only evicts stale
# Snort holds. Keep: NFSTREAM_ACTIVE_TIMEOUT < SNORT_JOIN_WAIT_S <= SNORT_HASH_TTL.
CORRELATION_WINDOW_S=2.5
SNORT_JOIN_WAIT_S=20

# alert_json fields expected by app/core/snort_tailer_worker.py (see also
# Testing/snort/snort.lua for the canonical SPACE-separated list — Snort 3's
# multi config type rejects comma-separated field names):
#
#   timestamp seconds action class priority msg sid gid rev
#   src_addr src_port src_ap dst_addr dst_port dst_ap
#   proto pkt_num pkt_len iface dir service
#   tcp_flags tcp_ack tcp_seq tcp_win tcp_len
#   icmp_type icmp_code icmp_id icmp_seq
#   udp_len ttl ip_id ip_len rule
